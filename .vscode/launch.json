    {
      "name": "FungibleTokenBridgeContract",
      "type": "neo-contract",
      "request": "launch",
      "program": "${workspaceFolder}/build/neow3j/FungibleTokenBridge.nef",
      "neo-express": "${workspaceFolder}/default.neo-express",
      "invocation": {
        "operation": "getOwner",
        "args": []
