      "storage": [
        {
          "key": "owner",
          "value": "@NNSyinBZAr8HMhjj95MfkKD1PY7YWoDweR"
        }
      ]
    },
    {
      "type": "java",
      "name": "Launch Deployment",
      "request": "launch",
      "mainClass": "network.bane.Deployment",
      "projectName": "bridge-neo-contracts"
    }
  ]
